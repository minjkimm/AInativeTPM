# Jira Cloud. Keep real values in your hosting provider's secret manager.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=labels = weekly-review ORDER BY priority DESC, duedate ASC
JIRA_PILLAR_FIELD=
JIRA_DECISION_FIELD=
JIRA_REASON_FIELD=

# Interview-safe Jira bridge. Used only when Jira credentials are absent.
# The Sheet must be published read-only or shared through an approved proxy.
JIRA_DEMO_SHEET_ID=
JIRA_DEMO_SHEET_NAME=Dashboard Contract
JIRA_DEMO_RANGE=A8:M55

# Smartsheet activation calendar.
SMARTSHEET_TOKEN=
SMARTSHEET_SHEET_ID=

# Interview-safe Smartsheet bridge. Used only when Smartsheet credentials are absent.
SMARTSHEET_DEMO_SHEET_ID=
SMARTSHEET_DEMO_SHEET_NAME=Activation Calendar
SMARTSHEET_DEMO_RANGE=A7:O119
SMARTSHEET_DEMO_TOTAL_RANGE=B3
SMARTSHEET_DEMO_OUTCOME_SHEET_NAME=Outcome & Learning
SMARTSHEET_DEMO_OUTCOME_RANGE=A1:U25

# Google Sheets budget workbook.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_BUDGET_RANGE=FY27 Q3 Budget!A1:M

# Public read-only budget Sheet; no API key is needed for the demo bridge.
GOOGLE_BUDGET_SHEET_ID=
GOOGLE_BUDGET_SHEET_NAME=FY27 Q3 Budget
GOOGLE_BUDGET_PUBLIC_RANGE=A1:M7

# Google Drive playbook folder. For production, use an expiring OAuth token
# or service-account flow instead of committing a long-lived access token.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Public read-only asset register used when Drive OAuth is absent.
GOOGLE_ASSET_REGISTER_SHEET_ID=
GOOGLE_ASSET_REGISTER_SHEET_NAME=Asset Register
GOOGLE_ASSET_REGISTER_RANGE=A1:N39

# Executive copilot. NVIDIA NIM uses an OpenAI-compatible chat endpoint.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Scheduled digest delivery.
DASHBOARD_URL=http://localhost:3000
SLACK_WEBHOOK_URL=
