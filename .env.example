# Jira Cloud. Keep real values in your hosting provider's secret manager.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=labels = weekly-review ORDER BY priority DESC, duedate ASC
JIRA_PILLAR_FIELD=
JIRA_DECISION_FIELD=
JIRA_REASON_FIELD=

# Smartsheet activation calendar.
SMARTSHEET_TOKEN=
SMARTSHEET_SHEET_ID=

# Google Sheets budget workbook.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_BUDGET_RANGE=FY27 Q3 Budget!A1:H

# Google Drive playbook folder. For production, use an expiring OAuth token
# or service-account flow instead of committing a long-lived access token.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=

# Scheduled digest delivery.
DASHBOARD_URL=http://localhost:3000
SLACK_WEBHOOK_URL=
